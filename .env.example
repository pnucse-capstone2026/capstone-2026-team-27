# playground/live_demo, playground/real_demo 실행에 필요한 환경변수 템플릿

# AWS 자격증명 (boto3 사용 시 필요)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# LLM (classification_agent/decision_agent/QA_agent가 판단 근거 생성에 씀)
# 여러 구글 계정의 키를 번호 순서대로 등록하면 토큰 만료 시 다음 키로 자동 전환한다. 
GEMINI_KEY_1=
GEMINI_KEY_2=

# Postgres (LangGraph checkpointer + 웹 제어판/Grafana가 보는 로그 저장소)
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Slack 알림 (notify_gate/QA_agent가 씀)
SLACK_WEBHOOK_URL=

# EC2 테스트 시나리오(zombie_live/real, ec2_over_live/real)용 리소스 ID
# 계정마다 다르므로 여기서만 관리 — ec2_overprovision_setup.py가 읽음
EC2_TEST_AMI_ID=
EC2_TEST_SECURITY_GROUP_ID=
EC2_TEST_SUBNET_ID=

# Lambda 테스트 시나리오(lambda_live/real)용 실행 역할 ARN — 계정마다 다름
LAMBDA_TEST_IAM_ROLE_ARN=
