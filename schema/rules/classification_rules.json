[
  {
    "rule_id": "CLF-001",
    "rule_type": "classification",
    "description": "AutoScaling EDoS 의심",
    "resource_types": [
      "AutoScaling"
    ],
    "conditions": {
      "metric_thresholds": {
        "request_count": {
          "op": ">",
          "ref": "mean",
          "factor": 2.0
        }
      },
      "sustained_fraction": {
        "metric": "request_count",
        "factor": 2.0,
        "min_fraction": 0.6,
        "recent_window_ratio": 0.2,
        "min_recent_points": 3
      },
      "skip_if_whitelisted": true
    },
    "result": {
      "anomaly_type": "risk_security",
      "interim_action": "AutoScaling 최대 인스턴스 수 임시 제한",
      "reasoning_template": "ALB 요청 수(request_count)가 평균 대비 {factor}배 이상 급증하고 최근 구간에도 계속 유지됨 -> EDoS 의심 (순간 스파이크였다면 단순 인기 폭증으로 간주)"
    },
    "priority": 10,
    "enabled": true,
    "created_at": "2025-01-01T00:00:00Z",
    "updated_at": "2026-09-01T12:07:14Z",
    "author": "system",
    "rationale": "2026-09-12 탐지 지표를 group_desired_capacity(값 가짓수가 적어 통계적 탐지에 불리)에서 request_count(ALB RequestCount)로 전환한 것에 맞춰 분류 규칙도 동일 지표로 갱신. request_count가 평균 대비 2배 이상 급증하는 것만으로는 단순 인기 폭증과 구분이 안 됨 - (1)최근 구간 대부분 계속 높게 유지되는지(sustained_fraction), (2)화이트리스트에 event_period로 등록된 알려진 이벤트 기간이 아닌지(skip_if_whitelisted)까지 같이 봐야 EDoS로 확정"
  },
  {
