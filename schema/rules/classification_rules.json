[
  {
    "rule_id": "CLF-001",
    "rule_type": "classification",
    "description": "AutoScaling EDoS 의심",
    "resource_types": [
      "AutoScaling"
    ],
    "conditions": {
      "metric_thresholds": {
        "group_desired_capacity": {
          "op": ">",
          "ref": "mean",
          "factor": 2.0
        }
      }
    },
    "result": {
      "anomaly_type": "risk_security",
      "interim_action": "AutoScaling 최대 인스턴스 수 임시 제한",
      "reasoning_template": "AutoScaling 인스턴스 수가 평균 대비 {factor}배 이상 급증 -> EDoS 의심"
    },
    "priority": 10,
    "enabled": true,
    "created_at": "2025-01-01T00:00:00Z",
    "updated_at": "2025-01-01T00:00:00Z",
    "author": "system",
    "rationale": "AutoScaling 그룹의 desired capacity가 평균 대비 2배 이상 급증하면 EDoS(Economic Denial of Service) 공격 가능성"
  },
  {
